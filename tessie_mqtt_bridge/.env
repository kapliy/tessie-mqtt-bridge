# Committed defaults. Safe to push to git — no secrets here.
# Override anything in this file by adding it to .env.local (gitignored).
# Both files are auto-loaded by bridge.py and probe_tessie.py at startup;
# values in .env.local win.

# --- required (set in .env.local) ---
TESSIE_TOKEN=
TESSIE_VIN=

# --- Tessie endpoint ---
# Override only for testing or future region changes.
TESSIE_URL=wss://streaming.tessie.com

# --- fields to publish ---
# Comma-separated. See FIELD_REGISTRY in bridge.py for the full menu.
# In the HA add-on UI this is a multi-select.
TESSIE_FIELDS=Location,Gear,VehicleSpeed

# --- device name in Home Assistant ---
# Drives the device label and (via slugification) auto-generated entity IDs:
# "Tesla (Streaming)" → device_tracker.tesla_streaming_location
# Pick something distinct if you have multiple cars.
DEVICE_NAME=Tesla (Streaming)

# --- MQTT broker (set host/user/pass in .env.local for local testing) ---
MQTT_HOST=
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=tesla_stream
MQTT_DISCOVERY_PREFIX=homeassistant

# --- home zone (set lat/lon in .env.local for local testing) ---
# If both are empty/0, bridge still publishes lat/lon but won't drive home/away.
# In add-on mode these are auto-fetched from zone.home.
HOME_LATITUDE=
HOME_LONGITUDE=
HOME_RADIUS_METERS=100

# --- robustness ---
# Don't publish availability=offline immediately on WS close; if the bridge
# reconnects within this many seconds, the entity stays "online" — covers
# Tessie's routine ~60-min idle close cleanly. 0 = current behavior (instant
# offline on every close). Range 0..300.
OFFLINE_GRACE_SECONDS=30
# HA-side staleness guard via discovery `expire_after`. Entity goes
# `unavailable` if no fresh state within this many seconds. Disabled by
# default (0): for slow-changing fields like DetailedChargeState, Tessie's
# heartbeat cadence may exceed this window, causing flapping that
# suppresses `not_from: [unavailable, unknown]` automation guards.
# Use the bridge's offline_grace_seconds + your trigger's `not_from` for
# replay protection instead. Range 0..86400 (24h).
EXPIRE_AFTER_SECONDS=0

# --- logging ---
LOG_LEVEL=INFO
